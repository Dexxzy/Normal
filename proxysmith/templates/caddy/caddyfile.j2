# Generated by ProxySmith — https://github.com/dexxzy/proxysmith
# Domain:   {{ config.domain }}
# SSL mode: {{ config.ssl_mode }}
# Services: {{ config.services | length }}
#
# Deploy:
#   cp this file to /etc/caddy/Caddyfile
#   caddy validate --config /etc/caddy/Caddyfile
#   caddy reload

{% if config.ssl_mode == "auto" and config.email %}
{
    email {{ config.email }}
    admin off
}

{% endif %}
{% for service in config.services %}
{{ service.fqdn }} {
{% if service.ssl_mode == "none" %}
    tls off
{% elif service.ssl_mode == "manual" %}
    tls /etc/ssl/certs/{{ service.fqdn }}.crt /etc/ssl/private/{{ service.fqdn }}.key
{% endif %}

    # Logging
    log {
        output file /var/log/caddy/{{ service.name }}.log
        format json
    }

    # Security headers
    header {
        X-Frame-Options           "SAMEORIGIN"
        X-Content-Type-Options    "nosniff"
        X-XSS-Protection          "1; mode=block"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=()"
{% if service.ssl_mode != "none" %}
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
{% endif %}
{% for key, value in service.headers.items() %}
        {{ key }} "{{ value }}"
{% endfor %}
    }

{% if service.cors %}
    # CORS
    header {
        Access-Control-Allow-Origin  "*"
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Authorization, Content-Type"
    }
    @options method OPTIONS
    respond @options 204
{% endif %}

{% if service.rate_limit %}
    # Rate limiting — {{ service.rate_limit }}
    rate_limit {
        zone {{ service.name }} {
            key    {remote_host}
            events {{ service.rate_limit | replace("/min", "") | replace("/s", "") | replace("/hour", "") | replace("/day", "") }}
            window {{ service.rate_limit | replace(service.rate_limit.split("/")[0] + "/", "") }}
        }
    }
{% endif %}

{% if service.auth == "basic" %}
    # Basic Auth
    basicauth * {
        # Add credentials: caddy hash-password
        # Paste hash here: admin <bcrypt-hash>
    }
{% elif service.auth == "forward" %}
    # Forward Auth (Authelia / Authentik)
    forward_auth authelia:9091 {
        uri /api/verify?rd=https://{host}
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
    }
{% endif %}

{% if service.max_upload %}
    # Upload size
    request_body {
        max_size {{ service.max_upload }}
    }
{% endif %}

    reverse_proxy {{ service.host }}:{{ service.port }} {
        header_up Host              {upstream_hostport}
        header_up X-Real-IP         {remote_host}
        header_up X-Forwarded-For   {remote_host}
        header_up X-Forwarded-Proto {scheme}
{% if service.websocket %}
        # WebSocket support is automatic in Caddy — no extra config needed
        transport http {
            read_buffer_size  4096
            write_buffer_size 4096
        }
{% endif %}
        health_uri    /
        health_interval 30s
        health_timeout  5s
    }
}
{% if not loop.last %}

{% endif %}
{% endfor %}
