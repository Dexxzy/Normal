# Generated by ProxySmith — https://github.com/dexxzy/proxysmith
# Domain:   {{ config.domain }}
# SSL mode: {{ config.ssl_mode }}
#
# Usage: merge the labels block for each service into your docker-compose.yml
# Traefik must be running with:
#   --providers.docker=true
#   --entrypoints.web.address=:80
#   --entrypoints.websecure.address=:443
{% if config.ssl_mode == "auto" %}
#   --certificatesresolvers.letsencrypt.acme.email={{ config.email }}
#   --certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json
#   --certificatesresolvers.letsencrypt.acme.httpchallenge.entrypoint=web
{% endif %}

version: "3.8"

services:
{% for service in config.services %}
  # -------------------------------------------------------------------
  # Service: {{ service.name }}  →  {{ service.fqdn }}
  # -------------------------------------------------------------------
  {{ service.name }}:
    image: your-image-here  # TODO: replace with actual image
    labels:
      - "traefik.enable=true"

      # Router — HTTP (redirect to HTTPS)
{% if service.use_ssl %}
      - "traefik.http.routers.{{ service.name }}-http.rule=Host(`{{ service.fqdn }}`)"
      - "traefik.http.routers.{{ service.name }}-http.entrypoints=web"
      - "traefik.http.routers.{{ service.name }}-http.middlewares={{ service.name }}-https-redirect"
      - "traefik.http.middlewares.{{ service.name }}-https-redirect.redirectscheme.scheme=https"
      - "traefik.http.middlewares.{{ service.name }}-https-redirect.redirectscheme.permanent=true"

      # Router — HTTPS
      - "traefik.http.routers.{{ service.name }}.rule=Host(`{{ service.fqdn }}`)"
      - "traefik.http.routers.{{ service.name }}.entrypoints=websecure"
{% if config.ssl_mode == "auto" %}
      - "traefik.http.routers.{{ service.name }}.tls.certresolver=letsencrypt"
{% elif config.ssl_mode == "manual" %}
      - "traefik.http.routers.{{ service.name }}.tls=true"
{% endif %}
{% else %}
      - "traefik.http.routers.{{ service.name }}.rule=Host(`{{ service.fqdn }}`)"
      - "traefik.http.routers.{{ service.name }}.entrypoints=web"
{% endif %}

      # Service / load balancer
      - "traefik.http.routers.{{ service.name }}.service={{ service.name }}"
      - "traefik.http.services.{{ service.name }}.loadbalancer.server.port={{ service.port }}"
      - "traefik.http.services.{{ service.name }}.loadbalancer.passHostHeader=true"

      # Middlewares chain
{% set mw_list = [] %}
{% if service.auth == "basic" %}
{% set _ = mw_list.append(service.name + "-basicauth") %}
{% elif service.auth == "forward" %}
{% set _ = mw_list.append(service.name + "-forwardauth") %}
{% endif %}
{% set _ = mw_list.append(service.name + "-securityheaders") %}
{% if service.rate_limit %}
{% set _ = mw_list.append(service.name + "-ratelimit") %}
{% endif %}
      - "traefik.http.routers.{{ service.name }}.middlewares={{ mw_list | join(",") }}"

      # Security headers middleware
      - "traefik.http.middlewares.{{ service.name }}-securityheaders.headers.frameDeny=true"
      - "traefik.http.middlewares.{{ service.name }}-securityheaders.headers.contentTypeNosniff=true"
      - "traefik.http.middlewares.{{ service.name }}-securityheaders.headers.browserXssFilter=true"
      - "traefik.http.middlewares.{{ service.name }}-securityheaders.headers.referrerPolicy=strict-origin-when-cross-origin"
{% if service.use_ssl %}
      - "traefik.http.middlewares.{{ service.name }}-securityheaders.headers.stsSeconds=31536000"
      - "traefik.http.middlewares.{{ service.name }}-securityheaders.headers.stsIncludeSubdomains=true"
{% endif %}
{% for key, value in service.headers.items() %}
      - "traefik.http.middlewares.{{ service.name }}-securityheaders.headers.customResponseHeaders.{{ key }}={{ value }}"
{% endfor %}

{% if service.auth == "basic" %}
      # Basic Auth middleware
      # Generate: echo $(htpasswd -nb user password) | sed -e s/\\$/\\$\\$/g
      - "traefik.http.middlewares.{{ service.name }}-basicauth.basicauth.users=user:$$apr1$$REPLACE$$ME$$"
{% elif service.auth == "forward" %}
      # Forward Auth middleware (Authelia)
      - "traefik.http.middlewares.{{ service.name }}-forwardauth.forwardauth.address=http://authelia:9091/api/verify?rd=https://auth.{{ config.domain }}"
      - "traefik.http.middlewares.{{ service.name }}-forwardauth.forwardauth.trustForwardHeader=true"
      - "traefik.http.middlewares.{{ service.name }}-forwardauth.forwardauth.authResponseHeaders=Remote-User,Remote-Groups,Remote-Name,Remote-Email"
{% endif %}

{% if service.rate_limit %}
      # Rate limit middleware — {{ service.rate_limit }}
{% set rl_parts = service.rate_limit.split("/") %}
      - "traefik.http.middlewares.{{ service.name }}-ratelimit.ratelimit.average={{ rl_parts[0] }}"
      - "traefik.http.middlewares.{{ service.name }}-ratelimit.ratelimit.period=1{{ rl_parts[1] }}"
      - "traefik.http.middlewares.{{ service.name }}-ratelimit.ratelimit.burst={{ (rl_parts[0] | int * 2) }}"
{% endif %}

{% if service.websocket %}
      # WebSocket support
      - "traefik.http.middlewares.{{ service.name }}-securityheaders.headers.customRequestHeaders.X-Forwarded-Proto=https"
{% endif %}
{% if not loop.last %}
{% endif %}
{% endfor %}
