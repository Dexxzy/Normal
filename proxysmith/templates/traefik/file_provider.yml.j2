# Generated by ProxySmith — https://github.com/dexxzy/proxysmith
# Domain:   {{ config.domain }}
# SSL mode: {{ config.ssl_mode }}
#
# Traefik file provider configuration (standalone, no Docker required)
# Deploy: place in /etc/traefik/dynamic/ or reference in traefik.yml:
#   providers:
#     file:
#       directory: /etc/traefik/dynamic/
#       watch: true

http:
  routers:
{% for service in config.services %}
{% if service.use_ssl %}
    {{ service.name }}-http:
      rule: "Host(`{{ service.fqdn }}`)"
      entryPoints:
        - web
      middlewares:
        - {{ service.name }}-https-redirect
      service: {{ service.name }}

{% endif %}
    {{ service.name }}:
      rule: "Host(`{{ service.fqdn }}`)"
      entryPoints:
{% if service.use_ssl %}
        - websecure
{% else %}
        - web
{% endif %}
      middlewares:
{% if service.auth == "basic" %}
        - {{ service.name }}-basicauth
{% elif service.auth == "forward" %}
        - {{ service.name }}-forwardauth
{% endif %}
        - {{ service.name }}-securityheaders
{% if service.rate_limit %}
        - {{ service.name }}-ratelimit
{% endif %}
      service: {{ service.name }}
{% if service.use_ssl %}
      tls:
{% if config.ssl_mode == "auto" %}
        certResolver: letsencrypt
{% endif %}
{% endif %}

{% endfor %}

  services:
{% for service in config.services %}
    {{ service.name }}:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "http://{{ service.host }}:{{ service.port }}"
        healthCheck:
          path: /
          interval: "30s"
          timeout: "5s"

{% endfor %}

  middlewares:
{% for service in config.services %}
{% if service.use_ssl %}
    {{ service.name }}-https-redirect:
      redirectScheme:
        scheme: https
        permanent: true

{% endif %}
    {{ service.name }}-securityheaders:
      headers:
        frameDeny: true
        contentTypeNosniff: true
        browserXssFilter: true
        referrerPolicy: "strict-origin-when-cross-origin"
{% if service.use_ssl %}
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        forceSTSHeader: true
{% endif %}
{% if service.headers %}
        customResponseHeaders:
{% for key, value in service.headers.items() %}
          {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}

{% if service.auth == "basic" %}
    {{ service.name }}-basicauth:
      basicAuth:
        # Generate: htpasswd -nb user password
        users:
          - "user:$apr1$REPLACE$ME$"

{% elif service.auth == "forward" %}
    {{ service.name }}-forwardauth:
      forwardAuth:
        address: "http://authelia:9091/api/verify?rd=https://auth.{{ config.domain }}"
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Name
          - Remote-Email

{% endif %}
{% if service.rate_limit %}
{% set rl_parts = service.rate_limit.split("/") %}
    {{ service.name }}-ratelimit:
      rateLimit:
        average: {{ rl_parts[0] }}
        period: "1{{ rl_parts[1] }}"
        burst: {{ rl_parts[0] | int * 2 }}

{% endif %}
{% endfor %}
{% if config.ssl_mode == "auto" %}

tls:
  stores:
    default:
      defaultCertificate:
        certFile: "/letsencrypt/cert.pem"
        keyFile:  "/letsencrypt/key.pem"
{% endif %}
